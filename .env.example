# Local dev uses the Prisma Postgres server started by `npm run db:dev`.
# That command prints a connection string — paste it here.
# For a hosted database (Neon, Supabase, RDS) just drop its URL in instead.
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=REPLACE_ME"

# Signing key for the session cookie. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="REPLACE_ME"
